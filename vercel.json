{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/Archive",
      "destination": "/Archive/index.html"
    },
    {
      "source": "/archive",
      "destination": "/archive/index.html"
    },
    {
      "source": "/Archive/(.*)",
      "destination": "/Archive/index.html"
    },
    {
      "source": "/archive/(.*)",
      "destination": "/archive/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=10, s-maxage=10, must-revalidate"
        }
      ]
    }
  ]
}