{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/[Aa]rchive",
      "dest": "/archive.html"
    },
    {
      "src": "/[Aa]rchive/(.*)",
      "dest": "/archive.html"
    },
    {
      "src": "/archive.html",
      "dest": "/archive.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=30, must-revalidate"
        }
      ]
    }
  ]
}